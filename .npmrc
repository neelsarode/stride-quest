# @convex-dev/auth 0.0.94 (pinned beta) peer-wants @auth/core ^0.41 while the
# repo deliberately pins ^0.37 — the tree was installed with legacy peer
# resolution, and CI runs `npm ci --legacy-peer-deps` to match. This makes a
# fresh-machine `npm ci`/`npm install` behave identically. Remove when the
# auth library leaves beta / @auth/core is upgraded (STR-88 backlog).
legacy-peer-deps=true
